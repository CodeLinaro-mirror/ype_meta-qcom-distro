From 959da88acfa4257ce7b32d864f5c1fae89ed7bce Mon Sep 17 00:00:00 2001
From: Viswanath Kraleti <quic_vkraleti@quicinc.com>
Date: Tue, 7 Jan 2025 12:55:24 +0530
Subject: [PATCH] fetch2/__init__.py: convert missing checksum error to warn

Change-Id: Id11805ee249392f13ff3b562c17fb20cf4edab5f
Signed-off-by: Puneet Yatnal <puneety@qti.qualcomm.com>
---
 bitbake/lib/bb/fetch2/__init__.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bitbake/lib/bb/fetch2/__init__.py b/bitbake/lib/bb/fetch2/__init__.py
index 5bf2c4b8cf..c9524ebdb8 100644
--- a/bitbake/lib/bb/fetch2/__init__.py
+++ b/bitbake/lib/bb/fetch2/__init__.py
@@ -1268,7 +1268,7 @@ def get_checksum_file_list(d):
                     found = True
                 filelist.append(f + ":" + str(os.path.exists(f)))
             if not found:
-                bb.fatal(("Unable to get checksum for %s SRC_URI entry %s: file could not be found"
+                bb.warn(("Unable to get checksum for %s SRC_URI entry %s: file could not be found"
                             "\nThe following paths were searched:"
                             "\n%s") % (d.getVar('PN'), os.path.basename(f), '\n'.join(paths)))
 
